{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "init"
        },
        "name": {
          "type": "string"
        },
        "topology": {
          "type": "string",
          "enum": [
            "single",
            "monorepo"
          ]
        },
        "selections": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "name",
        "topology",
        "selections",
        "capabilities"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "adopt"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "migrate"
        },
        "from": {
          "type": "number",
          "const": 1
        },
        "to": {
          "type": "number",
          "const": 2
        }
      },
      "required": [
        "type",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "add-capability"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipe": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "type",
        "capabilities",
        "target",
        "recipe",
        "options"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "context-sync"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://raw.githubusercontent.com/bloxy-studios/groot/main/schemas/v2/plan-intent.schema.json",
  "title": "Plan intent",
  "description": "What a plan was asked to do (init, adopt, migrate, add-capability, context-sync)."
}
