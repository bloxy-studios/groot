{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "groot.context"
    },
    "task": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "topology": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "single",
                "monorepo"
              ]
            },
            {
              "type": "string",
              "const": "unknown"
            }
          ]
        },
        "registered": {
          "type": "boolean"
        },
        "revision": {
          "type": "object",
          "properties": {
            "vcs": {
              "type": "string",
              "enum": [
                "git",
                "none"
              ]
            },
            "head": {
              "type": [
                "string",
                "null"
              ]
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "type": "boolean"
            },
            "worktreeFingerprint": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "vcs",
            "head",
            "branch",
            "dirty",
            "worktreeFingerprint"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "topology",
        "registered",
        "revision"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?![A-Za-z]:)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\\\0]+$"
              }
            ]
          },
          "kind": {
            "type": "string"
          },
          "framework": {
            "type": [
              "string",
              "null"
            ]
          },
          "entry": {
            "type": [
              "string",
              "null"
            ]
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "framework",
          "entry",
          "scripts",
          "relevance",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "recipe": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "recipe",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dec_[0-9a-z]{8,40}$"
          },
          "topic": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "authority": {
            "type": "string",
            "enum": [
              "human",
              "default",
              "recipe",
              "inferred"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "topic",
          "value",
          "authority",
          "rationale",
          "source",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string",
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?![A-Za-z]:)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\\\0]+$"
              }
            ]
          }
        },
        "required": [
          "purpose",
          "command",
          "cwd"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "consumer": {
            "anyOf": [
              {
                "type": "string",
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?![A-Za-z]:)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\\\0]+$"
              }
            ]
          },
          "scope": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "storage": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "consumer",
          "scope",
          "sensitivity",
          "required",
          "storage"
        ],
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "profile",
          "description",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev_[0-9a-z]{8,40}$"
          },
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "check",
          "status",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "task",
    "project",
    "units",
    "capabilities",
    "decisions",
    "conventions",
    "commands",
    "environment",
    "acceptance",
    "evidence",
    "gaps",
    "sources"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/bloxy-studios/groot/main/schemas/v2/context.schema.json",
  "title": "Task context",
  "description": "Concise task-scoped project knowledge (names only, never secret values)."
}
