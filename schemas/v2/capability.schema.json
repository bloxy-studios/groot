{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "product",
        "operational",
        "surface"
      ]
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "title",
    "kind",
    "description",
    "requires",
    "recipes"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/bloxy-studios/groot/main/schemas/v2/capability.schema.json",
  "title": "Capability descriptor",
  "description": "A product or operational result and its recipes."
}
