{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "GROOT_E_INTERNAL",
        "GROOT_E_USAGE",
        "GROOT_E_PREFLIGHT",
        "GROOT_E_GENERATOR",
        "GROOT_E_COMMAND_FAILED",
        "GROOT_E_VERIFY_FAILED",
        "GROOT_E_NOT_A_PROJECT",
        "GROOT_E_NOT_REGISTERED",
        "GROOT_E_MIGRATION_REQUIRED",
        "GROOT_E_UNSUPPORTED_SCHEMA",
        "GROOT_E_INVALID_DOCUMENT",
        "GROOT_E_UNSUPPORTED_PROJECT",
        "GROOT_E_INCOMPATIBLE",
        "GROOT_E_UNKNOWN_CAPABILITY",
        "GROOT_E_STALE_PLAN",
        "GROOT_E_CONFLICT",
        "GROOT_E_OWNERSHIP_CONFLICT",
        "GROOT_E_ROLLBACK_CONFLICT",
        "GROOT_E_PATH_OUTSIDE_PROJECT",
        "GROOT_E_POLICY_DENIED",
        "GROOT_E_BLOCKED",
        "GROOT_E_LOCKED",
        "GROOT_E_INTERRUPTED",
        "GROOT_E_NOT_FOUND",
        "GROOT_E_NOT_RESUMABLE",
        "GROOT_E_RUNNER_UNAVAILABLE",
        "GROOT_E_TASK_STATE"
      ]
    },
    "message": {
      "type": "string"
    },
    "hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "details": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "message",
    "hint",
    "exitCode",
    "details"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/bloxy-studios/groot/main/schemas/v2/error.schema.json",
  "title": "Error",
  "description": "Structured error with a stable GROOT_E_* identifier and exit code."
}
