{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "groot.task"
    },
    "id": {
      "type": "string",
      "pattern": "^task_[0-9a-z]{8,40}$"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "runner": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task_[0-9a-z]{8,40}$"
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "command",
              "verify"
            ]
          },
          "argv": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string",
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?![A-Za-z]:)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\\\0]+$"
              }
            ]
          },
          "profile": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "structural",
                  "build",
                  "runtime",
                  "product-flow"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "description",
          "kind",
          "argv",
          "cwd",
          "profile",
          "timeoutMs"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "wallTimeSec": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxBudgetUsd": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "wallTimeSec",
        "maxTurns",
        "maxBudgetUsd",
        "maxAttempts"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "blocked",
        "interrupted",
        "failed",
        "awaiting-review",
        "completed"
      ]
    },
    "statusReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "base": {
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": "string"
        }
      },
      "required": [
        "branch",
        "commit"
      ],
      "additionalProperties": false
    },
    "worktree": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "branch"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "runner": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex"
            ]
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "resumedFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "interrupted",
              "timed-out",
              "budget-exceeded"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "observed-cost",
                  "tokens",
                  "unavailable"
                ]
              },
              "costUsd": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cachedInputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "turns": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "costUsd",
              "inputTokens",
              "outputTokens",
              "cachedInputTokens",
              "turns",
              "durationMs",
              "source"
            ],
            "additionalProperties": false
          },
          "eventsLog": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\\\0]+$"
          },
          "finalMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "GROOT_E_INTERNAL",
                      "GROOT_E_USAGE",
                      "GROOT_E_PREFLIGHT",
                      "GROOT_E_GENERATOR",
                      "GROOT_E_COMMAND_FAILED",
                      "GROOT_E_VERIFY_FAILED",
                      "GROOT_E_NOT_A_PROJECT",
                      "GROOT_E_NOT_REGISTERED",
                      "GROOT_E_MIGRATION_REQUIRED",
                      "GROOT_E_UNSUPPORTED_SCHEMA",
                      "GROOT_E_INVALID_DOCUMENT",
                      "GROOT_E_UNSUPPORTED_PROJECT",
                      "GROOT_E_INCOMPATIBLE",
                      "GROOT_E_UNKNOWN_CAPABILITY",
                      "GROOT_E_STALE_PLAN",
                      "GROOT_E_CONFLICT",
                      "GROOT_E_OWNERSHIP_CONFLICT",
                      "GROOT_E_ROLLBACK_CONFLICT",
                      "GROOT_E_PATH_OUTSIDE_PROJECT",
                      "GROOT_E_POLICY_DENIED",
                      "GROOT_E_BLOCKED",
                      "GROOT_E_LOCKED",
                      "GROOT_E_INTERRUPTED",
                      "GROOT_E_NOT_FOUND",
                      "GROOT_E_NOT_RESUMABLE",
                      "GROOT_E_RUNNER_UNAVAILABLE",
                      "GROOT_E_TASK_STATE"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "hint": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exitCode": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "details": {
                    "anyOf": [
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "message",
                  "hint",
                  "exitCode",
                  "details"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "n",
          "runner",
          "sessionId",
          "resumedFrom",
          "startedAt",
          "finishedAt",
          "status",
          "exitCode",
          "usage",
          "eventsLog",
          "finalMessage",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev_[0-9a-z]{8,40}$"
      }
    },
    "review": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^rev_[0-9a-z]{8,40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "integration": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "integrated",
                "conflicted",
                "failed"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "targetBranch": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ev_[0-9a-z]{8,40}$"
              }
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "commit",
            "targetBranch",
            "evidence",
            "at",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "title",
    "objective",
    "createdAt",
    "updatedAt",
    "runner",
    "model",
    "dependsOn",
    "ownership",
    "acceptance",
    "limits",
    "status",
    "statusReason",
    "base",
    "worktree",
    "attempts",
    "evidence",
    "review",
    "integration"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/bloxy-studios/groot/main/schemas/v2/task.schema.json",
  "title": "Agent task",
  "description": "Bounded work for an installed coding agent, with attempts, usage, evidence, review, integration."
}
