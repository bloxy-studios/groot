{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "groot.review"
    },
    "id": {
      "type": "string",
      "pattern": "^rev_[0-9a-z]{8,40}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_[0-9a-z]{8,40}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "base": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed"
            ]
          },
          "additions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deletions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "withinOwnership": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "status",
          "additions",
          "deletions",
          "withinOwnership"
        ],
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skipped",
              "blocked"
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ev_[0-9a-z]{8,40}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "ownershipViolations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "secretFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "changes-requested"
      ]
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "human",
            "policy"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "taskId",
    "createdAt",
    "base",
    "head",
    "files",
    "acceptance",
    "ownershipViolations",
    "secretFindings",
    "verdict",
    "reviewer",
    "notes"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/bloxy-studios/groot/main/schemas/v2/review.schema.json",
  "title": "Task review",
  "description": "Diff summary, acceptance results, ownership violations, verdict."
}
